<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  inbox-log-analyzer launchd agent
  Runs /inbox-log-analyzer via Claude Code every 15 minutes.

  BEFORE INSTALLING — set PROJECT_DIR to your project root, then run:

    PROJECT_DIR="$HOME/apps/my-project"   # <-- change this
    sed "s|~/apps/my-project|$PROJECT_DIR|g" \
      skills/inbox-log-analyzer/com.orchestrate.inbox-analyzer.plist \
      > ~/Library/LaunchAgents/com.orchestrate.inbox-analyzer.plist
    launchctl load ~/Library/LaunchAgents/com.orchestrate.inbox-analyzer.plist

  To unload:
    launchctl unload ~/Library/LaunchAgents/com.orchestrate.inbox-analyzer.plist

  Logs (relative to WorkingDirectory):
    stdout -> .orchestrate/logs/inbox-analyzer.log
    stderr -> .orchestrate/logs/inbox-analyzer-err.log
-->

<plist version="1.0">
<dict>

  <!-- Agent label — must match the filename -->
  <key>Label</key>
  <string>com.orchestrate.inbox-analyzer</string>

  <!-- Command: invoke Claude Code with the /inbox-log-analyzer skill -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/claude</string>
    <string>-p</string>
    <string>/inbox-log-analyzer</string>
  </array>

  <!-- Run every 15 minutes (900 seconds) -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!--
    WorkingDirectory: REPLACE ~/apps/my-project with your actual project root.
    The skill reads/writes .orchestrate/ relative to this directory.
  -->
  <key>WorkingDirectory</key>
  <string>~/apps/my-project</string>

  <!-- Capture stdout to a persistent log inside the control plane -->
  <key>StandardOutPath</key>
  <string>~/apps/my-project/.orchestrate/logs/inbox-analyzer.log</string>

  <!-- Capture stderr separately for easier triage -->
  <key>StandardErrorPath</key>
  <string>~/apps/my-project/.orchestrate/logs/inbox-analyzer-err.log</string>

  <!-- Do not run immediately on launchctl load — wait for first interval -->
  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
