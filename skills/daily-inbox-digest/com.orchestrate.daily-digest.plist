<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  daily-inbox-digest launchd agent
  Runs /daily-inbox-digest via Claude Code once daily at 5pm.

  BEFORE INSTALLING — set PROJECT_DIR to your project root, then run:

    PROJECT_DIR="$HOME/apps/my-project"   # <-- change this
    sed "s|/Users/haimengzhou/apps/ai-console|$PROJECT_DIR|g" \
      skills/daily-inbox-digest/com.orchestrate.daily-digest.plist \
      > ~/Library/LaunchAgents/com.orchestrate.daily-digest.plist
    launchctl load ~/Library/LaunchAgents/com.orchestrate.daily-digest.plist

  To unload:
    launchctl unload ~/Library/LaunchAgents/com.orchestrate.daily-digest.plist

  Logs (relative to WorkingDirectory):
    stdout -> .orchestrate/logs/daily-digest.log
    stderr -> .orchestrate/logs/daily-digest-err.log
-->

<plist version="1.0">
<dict>

  <!-- Agent label — must match the filename -->
  <key>Label</key>
  <string>com.orchestrate.daily-digest</string>

  <!-- Command: invoke Claude Code with the /daily-inbox-digest skill -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/haimengzhou/.local/bin/claude</string>
    <string>-p</string>
    <string>/daily-inbox-digest</string>
  </array>

  <!-- Fire at 17:00 (5pm) every day -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>17</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!--
    WorkingDirectory: REPLACE /Users/haimengzhou/apps/ai-console with your actual project root.
    The skill reads .orchestrate/ and orchestrate-history/ relative to this directory.
  -->
  <key>WorkingDirectory</key>
  <string>/Users/haimengzhou/apps/ai-console</string>

  <!-- Capture stdout to a persistent log inside the control plane -->
  <key>StandardOutPath</key>
  <string>/Users/haimengzhou/apps/ai-console/.orchestrate/logs/daily-digest.log</string>

  <!-- Capture stderr separately for easier triage -->
  <key>StandardErrorPath</key>
  <string>/Users/haimengzhou/apps/ai-console/.orchestrate/logs/daily-digest-err.log</string>

  <!-- Do not run immediately on launchctl load — wait for 5pm -->
  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
